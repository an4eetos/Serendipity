# Listen address. When unset the API uses $PORT (set by Railway), then :8787.
API_ADDR=:8787
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for HS256-signed tokens (local dev / legacy projects).
SUPABASE_JWT_SECRET=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Terms of service version readers must accept before any write. Unset means
# the draft default; if set it must be 1-64 characters (empty fails startup).
TERMS_VERSION=draft-2026-10
# Default number of distinct words of one work that may be public (works.public_word_cap overrides it per work).
PUBLIC_WORD_CAP=2500
# Active custom characters per reader (whole number >= 1; archived and removed ones don't count).
CUSTOM_CHARACTER_LIMIT=20
# Character replies one reader may ask for per hour (whole number >= 1). Each is a paid model call.
CHARACTER_REPLIES_PER_HOUR=60
